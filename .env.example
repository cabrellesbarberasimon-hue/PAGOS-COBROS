# Cadena de conexión a Postgres. En Vercel, la proporciona el propio
# marketplace de base de datos (Vercel Postgres / Neon) al conectar el
# proyecto — cópiala tal cual a las variables de entorno del proyecto.
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"

# Contraseña única para acceder a la app. Se compara en texto plano contra la
# que introduce el usuario en /login; elige una contraseña larga y única
# (esto NO es un sistema de usuarios, es una única puerta de entrada).
APP_PASSWORD="cambia-esto-por-una-contraseña-larga-y-única"
