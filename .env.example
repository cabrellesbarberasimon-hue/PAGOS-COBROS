# Cadena de conexión a Postgres. En Vercel, la proporciona el propio
# marketplace de base de datos (Vercel Postgres / Neon) al conectar el
# proyecto — cópiala tal cual a las variables de entorno del proyecto.
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"

# Contraseña única para acceder a la app. Se compara en texto plano contra la
# que introduce el usuario en /login; elige una contraseña larga y única
# (esto NO es un sistema de usuarios, es una única puerta de entrada).
APP_PASSWORD="cambia-esto-por-una-contraseña-larga-y-única"

# --- Resumen diario de alertas por email (opcional) --------------------
# Si no se configuran estas 3 variables, el cron sigue ejecutándose pero no
# manda ningún email (no falla, simplemente no hace nada).
# 1. Crea una cuenta gratuita en https://resend.com y genera una API key.
# 2. Verifica un dominio o usa su dominio de pruebas para el remitente.
RESEND_API_KEY=""
ALERTAS_EMAIL_FROM="Tesorería BOCUBI <alertas@tudominio.com>"
ALERTAS_EMAIL_TO="simon@tuempresa.com"
# Protege /api/cron/resumen para que solo Vercel Cron pueda invocarlo.
# Vercel añade automáticamente "Authorization: Bearer <CRON_SECRET>" a las
# llamadas programadas en vercel.json si esta variable está configurada.
CRON_SECRET=""

# --- Asistente IA de consultas (opcional) -------------------------------
# Sin esta variable, la pantalla /asistente muestra cómo activarla en vez de
# fallar. Se obtiene en https://console.anthropic.com
ANTHROPIC_API_KEY=""
